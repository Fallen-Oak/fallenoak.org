---
import VideoList from "../components/VideoList.astro";
import { getAllVideos, getVideoYearsFrom, shouldShowVideo } from "../lib/videos";

const visibleVideos = (await getAllVideos()).filter(shouldShowVideo);
const years = getVideoYearsFrom(visibleVideos);
const activeYear = years[0];
const videos = visibleVideos.filter((video) => video.data.year === activeYear);
---

<VideoList videos={videos} years={years} activeYear={activeYear} />
