---
import Layout from "../../../layouts/Layout.astro";

import { Image } from "astro:assets";
import news from "../../../data/news/news-2026.js";
import img_Featured from "../../../assets/news/2026/hug-a-horse-event.jpg";
import { Icon } from "astro-icon/components";
import { ViewTransitions } from "astro:transitions";

const article = news[1];
const { author, title, content, img, date, id } = article;
---

<ViewTransitions />
<Layout title=`${title} - Fallen Oak`>
  <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <a
      class="mt-24 duration-300 hover:bg-blue-200 bg-blue-50 border-2 border-blue-200 hover:border-blue-400 rounded font-semibold text-base px-3 py-1 flex items-center gap-x-2"
      href="../"
      ><Icon name="mdi:arrow-back" class="text-2xl text-blue-600" />Back to News</a
    >
    <div class="w-full lg:w-1/2 mx-auto py-8">
      <article class="px-6 mx-auto flex flex-col lg:flex-col gap-x-12 gap-y-8">
        <div class="flex justify-center w-full lg:w-full">
          <Image 
          transition:name={id} src={img_Featured} alt="News" width="400" class="object-cover w-auto h-64 border-2 rounded border-black" />
        </div>
        <div class="flex flex-col gap-y-8 w-full lg:w-full">
          <div class="flex flex-col mx-auto gap-y-2 w-full">
            <h1 class="text-4xl lg:text-5xl font-semibold leading-none whitespace-wrap">{title}</h1>
            <p class="text-xs lg:text-sm">
              by
              <span class="text-blue-400">
                <span>{author}</span>
              </span>on
              <time datetime="2021-02-12 15:34:18-0200">{date}</time>
            </p>
          </div>
          <div class="flex flex-col gap-y-4 lg:text-base text-sm rounded border border-dashed border-black p-4 bg-amber-100">
            <!-- <p>{content}</p> -->
            <p>Join us on February 7th, from 11am - 3pm at Fallen Oak Equine Rescue, for the Hug a Horse Valentine’s Event, a heartfelt, hands-on day celebrating second chances and the impact of proper nutrition and rehabilitation.</p>
            <p>Fallen Oak is known for stepping up for horses others can’t, giving each one the time and care they need to heal and rebuild trust.</p>
            <p>Hosted in partnership with Triple Crown Feed, J&J Tack Shack, and Ian Robb with BEMER.</p>
            <br>
            <p>What to enjoy:</p>
            <p>Treat Station:</p>
            <p>“Buy” treats to give to the rescue horses in exchange for a donation including mints and Triple Crown Functional Wafers.</p>
            <p>BEMER Info Station:</p>
            <p>Learn about BEMER therapy from Ian Robb!</p>
            <p>Pick a Valentine!</p>
            <p>Shop at the J&J Tack Shack pop-up booth purchase feed, hay, shavings, and more to support the rescue horses.</p>
            <p>College of Central Florida Student Demonstration:</p>
            <p>Pre-vet students And Equine Student from the College of Central Florida will demonstrate how to take TPR (temperature, pulse, respiration) and identify the external parts of the horse.</p>
            <br>
            <p>The address for the event is <a href="https://maps.app.goo.gl/va6kBANKtENjtySy6">1 SE 123rd Street Rd, Ocala, FL 34480.</a></p>
            <p>For more Information, call <a href="tel:240-440-0807">240-440-0807</a>.</p>

        </div>
        </div>
      </article>
    </div>
  </div>
</Layout>
