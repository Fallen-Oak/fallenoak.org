---
import Layout from "../../layouts/Layout.astro";
import news from "../../data/news/news-2024.js";
import NewsComponent from "../../components/News/newspage.astro";
import NewsNav from "../../components/News/newsnav.astro";

//News images
import img_SemisAdoption from "../../assets/news/2024/semis-adoption.jpg";
import img_ThreeRescueHorses from "../../assets/news/2024/three-rescue-horses.jpg";
import img_MerchStore from "../../assets/news/2024/merch-store.jpg";
import img_GoodbyeHunter from "../../assets/news/2024/goodbye-hunter.jpg";
import img_HoneyUpdate from "../../assets/news/2024/honey-update.jpg";
import img_AHorseWithAnAttitude from "../../assets/news/2024/a-horse-with-an-attitude.jpg";
import img_WelcomeBackCody from "../../assets/news/2024/welcome-back-cody.jpg";
import img_TwoHorsesAvailableForAdoption from "../../assets/news/2024/two-horses-available-for-adoption.jpg";
import img_AprilsAdoption from "../../assets/news/2024/aprils-adoption.jpg";
import img_SkyesAdoption from "../../assets/news/2024/skyes-adoption.jpg";
import img_2BitssAdoption from "../../assets/news/2024/2bitss-adoption.jpg";
import img_HoneyCompletelyRehabbed from "../../assets/news/2024/honey-completely-rehabbed.jpg";
import img_NameThisNewHorse from "../../assets/news/2024/name-this-new-horse.jpg";
import img_GoodbyeLucy from "../../assets/news/2024/goodbye-lucy.jpg";
import img_MareFairAndMareDay from "../../assets/news/2024/mare-fair-and-mare-day.jpg";
import img_GoodbyeMontana from "../../assets/news/2024/goodbye-montana.jpg";
import img_HappyThanksgiving from "../../assets/news/2024/happy-thanksgiving.jpg";
import img_GivingTuesday from "../../assets/news/2024/giving-tuesday.jpg";

const reversed = news.slice().reverse();
const images = [img_GivingTuesday, img_HappyThanksgiving, img_GoodbyeMontana, img_MareFairAndMareDay, img_GoodbyeLucy, img_NameThisNewHorse, img_HoneyCompletelyRehabbed, img_2BitssAdoption, img_SkyesAdoption, img_AprilsAdoption, img_TwoHorsesAvailableForAdoption, img_WelcomeBackCody, img_AHorseWithAnAttitude, img_HoneyUpdate, img_GoodbyeHunter, img_MerchStore, img_ThreeRescueHorses, img_SemisAdoption];
---

<Layout title="News & Events - Fallen Oak">
  <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <div
      style="opacity: 0; animation: fadein 0.5s ease 0.2s forwards;"
      class="flex flex-col justify-center items-center w-full lg:w-full pt-24 lg:pt-32 lg:mb-0 gap-y-5 lg:gap-y-5"
    >
      <div
        class="text-3xl lg:text-7xl whitespace-nowrap uppercase font-semibold tracking-wider"
      >
        News & Events
      </div>
    </div>
    <div style="opacity: 0; animation: fadein 0.7s ease 0.2s forwards;"><NewsNav></NewsNav></div>
    <!-- <hr
      class="border-neutral-400 border-1 w-full lg:w-2/3 pb-8 lg:pb-16"
      style="opacity: 0; animation: fadein 0.5s ease 1.6s forwards;"
    /> -->
    <div
      class="grid grid-cols-1 2xl:grid-cols-5 lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2 gap-8 mb-12 lg:mt-8 mt-12"
      style="opacity: 0; animation: fadein 0.5s ease 0.4s forwards;"
    >
      {reversed.map((n, i) => <NewsComponent {...n} src={images[i]} />)}
    </div>
  </div>
</Layout>
