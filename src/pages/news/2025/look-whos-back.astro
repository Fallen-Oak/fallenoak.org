---
import Layout from "../../../layouts/Layout.astro";

import { Image } from "astro:assets";
import news from "../../../data/news/news-2025.js";
import img_Featured from "../../../assets/news/2025/look-whos-back.jpg";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";

const article = news[7];
const { author, title, content, img, date, id } = article;
---

<ClientRouter />
<Layout title=`${title} - Fallen Oak`>
  <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <a
      class="mt-24 duration-300 hover:bg-blue-200 bg-blue-50 border-2 border-blue-200 hover:border-blue-400 rounded font-semibold text-base px-3 py-1 flex items-center gap-x-2"
      href="../"
      ><Icon name="mdi:arrow-back" class="text-2xl text-blue-600" />Back to News</a
    >
    <div class="w-full lg:w-1/2 mx-auto py-8">
      <article class="px-6 mx-auto flex flex-col lg:flex-col gap-x-12 gap-y-8">
        <div class="flex justify-center w-full lg:w-full">
          <Image 
          transition:name={id} src={img_Featured} alt="News" width="400" class="object-cover w-auto h-64 border-2 rounded border-black" />
        </div>
        <div class="flex flex-col gap-y-8 w-full lg:w-full">
          <div class="flex flex-col mx-auto gap-y-2 w-full">
            <h1 class="text-4xl lg:text-5xl font-semibold leading-none whitespace-wrap">{title}</h1>
            <p class="text-xs lg:text-sm">
              by
              <span class="text-blue-400">
                <span>{author}</span>
              </span>on
              <time datetime="2021-02-12 15:34:18-0200">{date}</time>
            </p>
          </div>
          <div class="flex flex-col gap-y-4 lg:text-base text-sm rounded border border-dashed border-black p-4 bg-amber-100">
            <!-- <p>{content}</p> -->
            <p>I am pleased to announce Magnum is back!</p>
            <p>This 17’2 plus Oldenburg out of Art Deco is one of my favorite rescues of all time. Talk about personality! This guy will be 21 in April and has earned sanctuary for the rest of his days. Magnum came from Ohio almost three years ago after a serious suspensory injury ended his eventing career.</p>
            <p>After lots of rehab, he was deemed sound for light riding and was adopted within days. Magnum's prior adopter returned him after two members of his family became seriously ill, and all of his attention needed to be focused on helping to care for them.</p>
            <p>The rescue will always take back a horse that has been adopted if life circumstances change. It is part of our contract. I am thrilled Magnum is home once again and will remain at my personal farm for the rest of his days. He'll enjoy riding from time to time by my daughter Trinity, who is thrilled he’s back.</p>
            <p>Welcome home Mags, a truly gentle giant.</p>
        </div>
        </div>
      </article>
    </div>
  </div>
</Layout>
