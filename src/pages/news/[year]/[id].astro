---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";
import { getNewsId, isPonyMode } from "../../../lib/news";

export async function getStaticPaths() {
  const articles = await getCollection("news");

  return articles.map((article) => ({
    params: {
      year: String(article.data.year),
      id: getNewsId(article),
    },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { author, title, date, image, pony } = article.data;
const id = getNewsId(article);
const normalContent =
  pony && !isPonyMode() ? article.data.normalContent : undefined;
const normalBlocks =
  normalContent
    ?.split(/\n{2,}/)
    .map((block) => block.trim())
    .filter(Boolean) ?? [];

function renderInlineContent(content: string) {
  const escaped = content
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");

  return escaped.replace(/https?:\/\/[^\s<]+/g, (url) => {
    const trailing = url.match(/[.,!?;:]+$/)?.[0] ?? "";
    const href = trailing ? url.slice(0, -trailing.length) : url;

    return `<a href="${href}" target="_blank">${href}</a>${trailing}`;
  });
}
---

<ClientRouter />
<Layout title={`${title} - Fallen Oak`}>
  <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <a
      class="mt-24 duration-300 hover:bg-blue-200 bg-blue-50 border-2 border-blue-200 hover:border-blue-400 rounded font-semibold text-base px-3 py-1 flex items-center gap-x-2"
      href="../"
      ><Icon name="mdi:arrow-back" class="text-2xl text-blue-600" />Back to News</a
    >
    <div class="w-full lg:w-1/2 mx-auto py-8">
      <article class="px-6 mx-auto flex flex-col lg:flex-col gap-x-12 gap-y-8">
        <div class="flex justify-center w-full lg:w-full">
          <Image
            transition:name={id}
            src={image}
            alt="News"
            width="400"
            class="object-cover w-auto h-64 border-2 rounded border-black"
          />
        </div>
        <div class="flex flex-col gap-y-8 w-full lg:w-full">
          <div class="flex flex-col mx-auto gap-y-2 w-full">
            <h1 class="text-4xl lg:text-5xl font-semibold leading-none whitespace-wrap">{title}</h1>
            <p class="text-xs lg:text-sm">
              by
              <span class="text-blue-400">
                <span>{author}</span>
              </span>on
              <time datetime={date}>{date}</time>
            </p>
          </div>
          <div
            class="news-article-body flex flex-col gap-y-4 lg:text-base text-sm rounded border border-dashed border-black p-4 bg-amber-100"
          >
            {
              normalContent
                ? normalBlocks.map((block) => <p set:html={renderInlineContent(block)} />)
                : <Content />
            }
          </div>
        </div>
      </article>
    </div>
  </div>
</Layout>

<style>
  .news-article-body :global(a) {
    color: blue;
  }

  .news-article-body :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
</style>
