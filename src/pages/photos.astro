---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import DisplayPony from "../components/DisplayPony.astro";
import img_HorseHeader from "../assets/Solo Horse Pics/Red/Red_5.JPG";
import img_HorseGallery from "../assets/Solo Horse Pics/Marly/Marly_4.jpg";
import img_MareDay from "../assets/mareday/mareday.jpg";

const color = "#bfdbfe";
---

<Layout title="Photos - Fallen Oak">
    <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <div style="opacity: 0; animation: fadein 0.5s ease 0.2s forwards;" class="flex flex-col justify-center items-center w-full lg:w-full pt-24 lg:pt-32 pb-8 mb-12 lg:mb-0 lg:pb-8 gap-y-20 lg:gap-y-20"
    >
      <div
        class="text-3xl lg:text-7xl whitespace-nowrap uppercase font-semibold tracking-wider"
      >
        Photos
      </div>
      <div
        class="relative flex items-center justify-center max-h-40 w-full"
      >
        <Image
          src={img_HorseHeader}
          width="400"
          alt=""
          format="avif"
          style="filter: drop-shadow(0 5px 5px #000)"
          class="max-h-64 w-auto sm:max-h-auto sm:h-64 lg:max-w-lg mx-auto z-0 rounded-lg -rotate-3 bg-blue-100 border-white border-8"
        />
      </div>
    <div
      style="opacity: 0; animation: fadein 0.5s ease 0.8s forwards;"
      class="rounded-lg flex flex-col items-center p-2 sm:p-4 text-center text-base lg:text-xl w-full xl:w-2/3 lg:mb-4 mb-4"
    >
      <div class="mt-0 flex flex-col gap-y-8">
        <div class="flex flex-col items-center gap-y-4">
          <div
            class="text-3xl lg:text-5xl font-bold decoration-2"
          >
            The Horses of Fallen Oak
          </div>
          <br />
		  <a
  class="duration-300 cursor-pointer max-w-xs lg:max-w-72 p-6 lg:p-4 rounded-md border-2 border-black bg-white hover:bg-amber-100 hover:text-black "
  href={`https://photos.app.goo.gl/QrWobHyZTPmDzZAi9`}
>  
  <Image
    src={img_HorseGallery}
    format="avif"
    alt="Horse gallery preview image"
    height="300"
    class="object-cover object-center w-full rounded-md h-72 lg:h-48 bg-gray-500"
  />
  <div class="mt-6 mb-2">
    <h2 class="text-xl font-semibold tracking-wide">Horse Gallery</h2>
  </div>
  <p class="text-sm line-clamp-4">
    Take a look at the beloved equines helped by Fallen Oak!
  </p>

  <div class="flex justify-center mt-4">
    <div
      class="px-2 py-1 lg:text-sm lg:px-3 lg:py-1 button button--photos border-2 border-black"
    >
      <span>View</span>
    </div>
  </div>
</a>
<DisplayPony>
    <br />
    <hr
    class="border-neutral-400 border-1 w-full lg:w-2/3 pt-0 pb-0"
    style="opacity: 0; animation: fadein 0.5s ease .8s forwards;"
  />
  <div class="mt-0 flex flex-col gap-y-8">
    <div class="flex flex-col items-center gap-y-4">
      <div
        class="text-3xl lg:text-5xl font-bold decoration-2"
      >
        Events
      </div>
      <br />
  <a
  class="duration-300 cursor-pointer max-w-xs lg:max-w-72 p-6 lg:p-4 rounded-md border-2 border-black bg-white hover:bg-amber-100 hover:text-black "
  href={`https://photos.app.goo.gl/uj2XiMP5ZeNNzjRE6`}
>  
  <Image
    src={img_MareDay}
    format="avif"
    alt="Horse gallery preview image"
    height="300"
    class="object-cover object-center w-full rounded-md h-72 lg:h-48 bg-gray-500"
  />
  <div class="mt-6 mb-2">
    <h2 class="text-xl font-semibold tracking-wide">Mare Day 2024</h2>
  </div>
  <p class="text-sm line-clamp-4">
    Take a gander at Fallen Oak's inagural Mare Day, held on October 1, 2024.
  </p>

  <div class="flex justify-center mt-4">
    <div
      class="px-2 py-1 lg:text-sm lg:px-3 lg:py-1 button button--photos border-2 border-black"
    >
      <span>View</span>
    </div>
  </div>
</a>
</DisplayPony>
</div>

  <!-- <hr class="solid">-->

  <div
    style="opacity: 0; animation: fadein 0.5s ease 0.8s forwards;"
    class="grid grid-cols-1 lg:grid-cols-1 gap-4 lg:mb-8 mb-4"
  >
    <!--<div class="text-5xl mt-1">Maxwell Wurtz, Daniel Mahoney</div>-->
  </div>

  <!-- <div class="text-center mr-auto ml-auto"><strong class="">Website design by 15</strong></div> -->
  <style define:vars={{ color }}>
    @reference "../styles/global.css";

    .desc {
      background-color: var(--color);
    }
    .speech-bubble {
      position: relative;
    }

    .speech-bubble:after {
      content: "";
      position: absolute;
      top: 0;
      right: 14%;
      width: 0;
      height: 0;
      border: 28px solid transparent;
      border-bottom-color: var(--color);
      border-top: 0;
      border-right: 0;
      margin-left: -14px;
      margin-top: -28px;
    }

    .button {
      pointer-events: auto;
      cursor: pointer;
      background: #000;
      /* border: none; */
      font-size: inherit;
      position: relative;
      display: inline-block;
    }

    .button::before,
    .button::after {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
    .button--photos {
      text-transform: uppercase;
      @apply lg:text-sm text-sm font-semibold tracking-wider;
      border-radius: 0.5rem;
      overflow: hidden;
      color: #fff;
      background: #fefce8;
    }

    .button--photos span {
      position: relative;
      mix-blend-mode: difference;
    }

    .button--photos::before {
      content: "";
      background: #000;
      width: 120%;
      left: -10%;
      transform: skew(30deg);
      transition: transform 0.8s cubic-bezier(0.3, 1, 0.8, 1);
    }

    .button--photos:hover::before {
      transform: translate3d(100%, 0, 0);
    }
  </style>
</Layout>
