---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";
import { getVideoId, shouldShowVideo } from "../../../lib/videos";

export async function getStaticPaths() {
  const videos = (await getCollection("videos")).filter(shouldShowVideo);

  return videos.map((video) => ({
    params: {
      year: String(video.data.year),
      id: getVideoId(video),
    },
    props: { video },
  }));
}

const { video } = Astro.props;
const { Content } = await render(video);
const { title, date, embed } = video.data;
const shouldDisplay = shouldShowVideo(video);
---

<ClientRouter />
<Layout title={`${title} - Fallen Oak`}>
  <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <a
      class="mt-24 duration-300 hover:bg-blue-200 bg-blue-50 border-2 border-blue-200 hover:border-blue-400 rounded font-semibold text-base px-3 py-1 flex items-center gap-x-2"
      href="../"
      ><Icon name="mdi:arrow-back" class="text-2xl text-blue-600" />Back to Videos</a
    >
    {
      shouldDisplay && (
        <div class="w-full lg:w-1/2 mx-auto py-8">
          <article class="px-6 mx-auto flex flex-col lg:flex-col gap-x-12 gap-y-8">
            <div
              set:html={embed}
              class="video-embed flex justify-center w-full lg:w-full"
            />
            <div class="flex flex-col gap-y-4 w-full lg:w-full">
              <div class="flex flex-col mx-auto gap-y-2 w-full">
                <h1 class="text-4xl lg:text-5xl font-semibold leading-none">
                  {title}
                </h1>
                <p class="text-xs lg:text-sm">
                  <time datetime={date}>{date}</time>
                </p>
              </div>

              <div class="video-body flex flex-col gap-y-4 lg:text-base text-sm rounded border border-dashed border-black p-4 bg-amber-100">
                <Content />
              </div>
            </div>
          </article>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .video-embed :global(iframe) {
    max-width: 100%;
  }

  .video-body :global(a) {
    color: blue;
  }
</style>
