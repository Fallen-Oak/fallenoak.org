---
import Layout from "../layouts/Layout.astro";
import news from "../data/news/news-2025.js";
import NewsComponent from "../components/News/newspage.astro";
import NewsNav from "../components/News/newsnav.astro";

//News images
import img_GoodbyeDakota from "../assets/news/2025/goodbye-dakota.jpg";
import img_JoyousAdoptions from "../assets/news/2025/joyous-adoptions.jpg";
import img_FlashsAdoption from "../assets/news/2025/flashs-adoption.jpg";
import img_GoodbyeMajor from "../assets/news/2025/goodbye-major.jpg";
import img_MareDay from "../assets/news/2025/mare-day.jpg";
import img_WelcomeAlena from "../assets/news/2025/welcome-alena.jpg";
import img_DinnerWithHorses from "../assets/news/2025/dinner-with-horses.jpg";
import img_LookWhosBack from "../assets/news/2025/look-whos-back.jpg";
import img_VideoAndPhotoPages from "../assets/news/2025/video-and-photo-pages.jpg";
import img_ABeautifulHorse from "../assets/news/2025/a-beautiful-horse.jpg";
import img_LadybugsAdoption from "../assets/news/2025/ladybugs-adoption.jpg";
import img_BellesAdoption from "../assets/news/2025/belles-adoption.jpg";
import img_LadybugUpdate from "../assets/news/2025/ladybug-update.jpg";
import img_HiSi from "../assets/news/2025/hi-si.jpg";
import img_SoLongMarley from "../assets/news/2025/so-long-marley.jpg";
import img_BigRedsPassing from "../assets/news/2025/big-reds-passing.jpg";
import img_BeautyUpForAdoption from "../assets/news/2025/beauty-up-for-adoption.jpg";

const reversed = news.slice().reverse();
const images = [img_BeautyUpForAdoption, img_BigRedsPassing, img_SoLongMarley, img_HiSi, img_LadybugUpdate, img_BellesAdoption, img_LadybugsAdoption, img_ABeautifulHorse, img_VideoAndPhotoPages, img_LookWhosBack, img_DinnerWithHorses, img_WelcomeAlena, img_MareDay, img_GoodbyeMajor, img_FlashsAdoption, img_JoyousAdoptions, img_GoodbyeDakota];
---

<Layout title="News & Events - Fallen Oak">
  <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <div
      style="opacity: 0; animation: fadein 0.5s ease 0.2s forwards;"
      class="flex flex-col justify-center items-center w-full lg:w-full pt-24 lg:pt-32 lg:mb-0 gap-y-5 lg:gap-y-5"
    >
      <div
        class="text-3xl lg:text-7xl whitespace-nowrap uppercase font-semibold tracking-wider"
      >
        News & Events
      </div>
    </div>
    <div style="opacity: 0; animation: fadein 0.7s ease 0.2s forwards;"><NewsNav></NewsNav></div>
    <!-- <hr
      class="border-neutral-400 border-1 w-full lg:w-2/3 pb-8 lg:pb-16"
      style="opacity: 0; animation: fadein 0.5s ease 1.6s forwards;"
    /> -->
    <div
      class="grid grid-cols-1 2xl:grid-cols-5 lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2 gap-8 mb-12 lg:mt-8 mt-12"
      style="opacity: 0; animation: fadein 0.5s ease 0.4s forwards;"
    >
      {reversed.map((n, i) => <NewsComponent {...n} src={images[i]} />)}
    </div>
  </div>
</Layout>
