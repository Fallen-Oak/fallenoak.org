---
import Layout from "../layouts/Layout.astro";
import news from "../data/news/news-2025.js";
import NewsComponent from "../components/News/newspage.astro";
import NewsNav from "../components/News/newsnav.astro";

//News images
import imgGoodbyeDakota from "../assets/news/2025/goodbye-dakota.jpg";
import imgJoyousAdoptions from "../assets/news/2025/joyous-adoptions.jpg";
import imgFlashsAdoption from "../assets/news/2025/flashs-adoption.jpg";
import imgGoodbyeMajor from "../assets/news/2025/goodbye-major.jpg";
import imgMareDay from "../assets/news/2025/mare-day.jpg";
import imgWelcomeAlena from "../assets/news/2025/welcome-alena.jpg";
import imgDinnerWithHorses from "../assets/news/2025/dinner-with-horses.jpg";
import imgLookWhosBack from "../assets/news/2025/look-whos-back.jpg";

const reversed = news.slice().reverse();
const images = [imgLookWhosBack, imgDinnerWithHorses, imgWelcomeAlena, imgMareDay, imgGoodbyeMajor, imgFlashsAdoption, imgJoyousAdoptions, imgGoodbyeDakota];
---

<Layout title="News & Events - Fallen Oak">
  <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <div
      style="opacity: 0; animation: fadein 0.5s ease 0.2s forwards;"
      class="flex flex-col justify-center items-center w-full lg:w-full pt-24 lg:pt-32 mb-12 lg:mb-0 gap-y-5 lg:gap-y-5"
    >
      <div
        class="text-3xl lg:text-7xl whitespace-nowrap uppercase font-semibold tracking-wider"
      >
        News & Events
      </div>
    </div>
    <div style="opacity: 0; animation: fadein 0.7s ease 0.2s forwards;"><NewsNav></NewsNav></div>
    <!-- <hr
      class="border-neutral-400 border-1 w-full lg:w-2/3 pb-8 lg:pb-16"
      style="opacity: 0; animation: fadein 0.5s ease 1.6s forwards;"
    /> -->
    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12 mt-8"
      style="opacity: 0; animation: fadein 0.5s ease 0.4s forwards;"
    >
      {reversed.map((n, i) => <NewsComponent {...n} src={images[i]} />)}
    </div>
  </div>
</Layout>
