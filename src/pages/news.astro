---
import Layout from "../layouts/Layout.astro";
import news from "../data/news/news-2026.js";
import NewsComponent from "../components/News/newspage.astro";
import NewsNav from "../components/News/newsnav.astro";

//News images
import img_HayFundraiser from "../assets/news/2026/hay-fundraiser.jpg";
import img_HugAHorseEvent from "../assets/news/2026/hug-a-horse-event.jpg";

const reversed = news.slice().reverse();
const images = [img_HugAHorseEvent,img_HayFundraiser];
---

<Layout title="News & Events - Fallen Oak">
  <div
    class="bg-[#fefce8] min-h-[calc(100vh-10rem)] px-4 lg:px-0 flex flex-col items-center"
  >
    <div
      style="opacity: 0; animation: fadein 0.5s ease 0.2s forwards;"
      class="flex flex-col justify-center items-center w-full lg:w-full pt-24 lg:pt-32 lg:mb-0 gap-y-5 lg:gap-y-5"
    >
      <div
        class="text-3xl lg:text-7xl whitespace-nowrap uppercase font-semibold tracking-wider"
      >
        News & Events
      </div>
    </div>
    <div style="opacity: 0; animation: fadein 0.7s ease 0.2s forwards;"><NewsNav></NewsNav></div>
    <!-- <hr
      class="border-neutral-400 border-1 w-full lg:w-2/3 pb-8 lg:pb-16"
      style="opacity: 0; animation: fadein 0.5s ease 1.6s forwards;"
    /> -->
    <div
      class="grid grid-cols-1 2xl:grid-cols-5 lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2 gap-8 mb-12 lg:mt-8 mt-12"
      style="opacity: 0; animation: fadein 0.5s ease 0.4s forwards;"
    >
      {reversed.map((n, i) => <NewsComponent {...n} src={images[i]} />)}
    </div>
  </div>
</Layout>
