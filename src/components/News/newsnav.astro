---
const { pathname } = Astro.url;
const { years = [2026, 2025, 2024], activeYear } = Astro.props;
---

<header
  class="z-40 h-20 xl:h-12 w-full -mb-10 sm:mb-0 relative uppercase"
>
  </div><div
    class="relative mx-auto flex h-full flex-row items-center justify-between gap-4 px-6 xl:container"
  >
    <div class="flex h-full flex-nowrap items-center gap-20 2xl:gap-32">
      <nav class="tracking-wide xl:flex" aria-label="Navigation">
        <h2 class="sr-only" id="navigation">News Navigation</h2><menu
          class="text-heading flex space-x-10">
          {
            years.map((year) => (
              <li>
                <a
                  href={`/news/${year}`}
                  class={`${Number(activeYear) === year || pathname.includes(String(year)) || (pathname === "/news" || pathname === "/news/") && years[0] === year ? "underline" : null} hover:underline underline-offset-[6px] inline-flex whitespace-nowrap text-3xl py-4 font-semibold`}
                >
                  {year}
                </a>
              </li>
            ))
          }
        </menu>
      </nav>
    </div>
  </div>
</header>

<style>
  @reference "../../styles/global.css";

  label {
    @apply active:bg-white rounded;
  }
  .bg-heading::before {
    @apply bg-black;
  }
  .bg-heading::after {
    @apply bg-black;
  }

  label {
  }
</style>
