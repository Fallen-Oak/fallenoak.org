---
const { pathname } = Astro.url;
---

<header
  class="z-40 h-20 xl:h-12 w-full -mb-10 sm:mb-0 relative uppercase"
>
  </div><div
    class="relative mx-auto flex h-full flex-row items-center justify-between gap-4 px-6 xl:container"
  >
    <div class="flex h-full flex-nowrap items-center gap-20 2xl:gap-32">
      <nav class="tracking-wide xl:flex" aria-label="Navigation">
        <h2 class="sr-only" id="navigation">News Navigation</h2><menu
          class="text-heading flex space-x-10">
            <li>
            <a
              href="/news/2026"
              class={`${pathname.includes("2026") || pathname === "/news" || pathname === "/news/" ? "underline" : null} hover:underline underline-offset-[6px] inline-flex whitespace-nowrap text-3xl py-4 font-semibold`}
              >2026</a>
          </li>
          <li>
            <a
              href="/news/2025"
              class={`${pathname.includes("2025") ? "underline" : null} hover:underline underline-offset-[6px] inline-flex whitespace-nowrap text-3xl py-4 font-semibold`}
              >2025</a>
          </li>
          <li>
            <a
              href="/news/2024"
              class={`${pathname.includes("2024") ? "underline" : null} hover:underline underline-offset-[6px] inline-flex whitespace-nowrap text-3xl py-4 font-semibold`}
              >2024</a>
          </li>
        </menu>
      </nav>
    </div>
  </div>
</header>

<style>
  @reference "../../styles/global.css";

  label {
    @apply active:bg-white rounded;
  }
  .bg-heading::before {
    @apply bg-black;
  }
  .bg-heading::after {
    @apply bg-black;
  }

  label {
  }
</style>
